# Quicky Notes server environment
# Copy to .env for local overrides; Railway sets these in the service variables.

# Port to listen on. Railway injects PORT automatically.
PORT=8787

# Optional. On Railway, an attached volume is detected automatically from
# RAILWAY_VOLUME_MOUNT_PATH. Set DATA_DIR only to choose a directory inside it.
DATA_DIR=./data

# Set to false to stop new account creation on a private server.
ALLOW_SIGNUP=true
